# Parrot AI providers — copy to `.env.local` and fill in the ones you use.
# Keys are read server-side only and are never written to parrot.db.

# Hosted providers (need an API key)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Local runtimes (no key needed; override the base URL only if non-default)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# LMSTUDIO_BASE_URL=http://localhost:1234/v1

# Generic OpenAI-compatible endpoint (optional)
# OPENAI_COMPATIBLE_BASE_URL=
# OPENAI_COMPATIBLE_API_KEY=

# Web search tool (optional; enable + pick a provider in Settings)
TAVILY_API_KEY=
EXA_API_KEY=
